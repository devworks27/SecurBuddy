# Copy this file to .env and fill in your own keys. All three are optional —
# the app runs without them, just with reduced functionality.

# Free AI model host for the chat copilot (https://console.groq.com)
GROQ_API_KEY=

# IP reputation: abuse confidence, ISP, geo, Tor detection (https://www.abuseipdb.com)
ABUSEIPDB_API_KEY=

# URL reputation: multi-engine scan verdicts (https://www.virustotal.com)
VIRUSTOTAL_API_KEY=

# Optional: override the model used for chat completions.
# SECURBUDDY_MODEL=openai/gpt-oss-20b